<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MiniCodex.App.ViewModels"
             xmlns:views="clr-namespace:MiniCodex.App.Views"
             x:Class="MiniCodex.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
    <!-- patch 0.5.0a3 applied -->
    <Panel Background="Transparent">
        <Panel.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ConfirmRenameTagCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding CancelRenameTagCommand}" />
            <KeyBinding Gesture="Enter" Command="{Binding ConfirmColorPickerCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding CancelColorPickerCommand}" />
            <KeyBinding Gesture="Enter" Command="{Binding ConfirmGroupTagCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding CancelGroupTagCommand}" />
            <KeyBinding Gesture="Enter" Command="{Binding ConfirmGroupRemoveCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding CancelGroupRemoveCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding ClearSelectionCommand}" />
            <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllVisibleCommand}" />
        </Panel.KeyBindings>
        <Grid ColumnDefinitions="200,*" Background="Transparent">
            <Border Grid.Column="0" Background="{DynamicResource GlassPanelBackgroundBrush}" BorderBrush="{DynamicResource GlassPanelBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusLarge}" Margin="8,8,4,8" Padding="8" BoxShadow="{DynamicResource GlassPanelShadow}">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="{Binding TagsHeader}" FontWeight="Bold" Margin="6,4,6,8"/>
                    <TreeView x:Name="TagTreeView" Grid.Row="1" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding RenameLabel}" Command="{Binding RenameCommand}"/>
                                            <MenuItem Header="{Binding DeleteLabel}" Command="{Binding DeleteCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding ClearColorLabel}" Command="{Binding ClearColorCommand}"/>
                                            <Separator/>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#E67E22">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#E67E22" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#E74C3C">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#E74C3C" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#F39C12">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#F39C12" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#2ECC71">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#2ECC71" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#3498DB">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#3498DB" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#9B59B6">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#9B59B6" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#95A5A6">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#95A5A6" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#34495E">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#34495E" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Header="{Binding CustomColorLabel}" Command="{Binding CustomColorCommand}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding ColorBrush}"
                                             IsVisible="{Binding HasColor}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding UsageCount}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding CollectionsHeader}" FontWeight="Bold" Margin="6,8,6,4" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="&#x00D7;"
                                Command="{Binding DeleteCollectionCommand}"
                                ToolTip.Tip="{Binding DeleteCollectionTooltip}"
                                Background="Transparent" BorderThickness="0"
                                Padding="4,0" FontSize="14"
                                Margin="0,4,4,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox Grid.Row="3" ItemsSource="{Binding Collections}"
                             SelectedItem="{Binding SelectedCollection, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             MaxHeight="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding ClearColorLabel}" Command="{Binding ClearColorCommand}"/>
                                            <Separator/>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#E67E22">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#E67E22" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#E74C3C">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#E74C3C" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#F39C12">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#F39C12" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#2ECC71">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#2ECC71" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#3498DB">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#3498DB" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#9B59B6">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#9B59B6" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#95A5A6">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#95A5A6" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding SetColorCommand}" CommandParameter="#34495E">
                                                <MenuItem.Header><Border Width="16" Height="16" CornerRadius="8" Background="#34495E" Margin="4,2"/></MenuItem.Header>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="4,0,6,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding ColorBrush}"
                                             IsVisible="{Binding HasColor}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Padding="0,2"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Background="Transparent">
                <Border Grid.Row="0" Background="{DynamicResource GlassPanelBackgroundBrush}" BorderBrush="{DynamicResource GlassPanelBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusLarge}" Margin="8,8,8,4" Padding="8" BoxShadow="{DynamicResource GlassPanelShadow}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchQuery}"
                             Watermark="{Binding SearchPlaceholder}" Width="300" VerticalAlignment="Center"/>
                    <Button Content="{Binding ScanButtonText}" Click="OnScanClick"/>
                    <Button Content="{Binding DuplicatesButtonText}" Command="{Binding ToggleDuplicatesCommand}"/>
                        <Button Content="{Binding SaveFilterButtonText}" Command="{Binding SaveCurrentFilterAsCollectionCommand}"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                                 Width="120" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" IsVisible="{Binding IsMultiSelection}"
                    Background="{DynamicResource GlassPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource GlassPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusLarge}"
                    Margin="8,0,8,4" Padding="8,6"
                    BoxShadow="{DynamicResource GlassPanelShadow}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding GroupSelectionStatusText}"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="{Binding GroupAddTagMenuText}" Command="{Binding GroupAddTagCommand}"/>
                    <Button Content="{Binding GroupCopyPathsMenuText}" Command="{Binding GroupCopyPathsCommand}"/>
                    <Button Content="{Binding GroupFindDuplicatesMenuText}" Command="{Binding GroupFindDuplicatesCommand}"/>
                    <Button Content="{Binding GroupRemoveMenuText}" Command="{Binding GroupRemoveCommand}"/>
                    <Button Content="{Binding GroupClearText}" Command="{Binding ClearSelectionCommand}"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" Background="Transparent" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="CardsHost" Background="Transparent"
                      PointerPressed="OnCardsPointerPressed"
                      PointerMoved="OnCardsPointerMoved"
                      PointerReleased="OnCardsPointerReleased">
                    <ItemsControl x:Name="CardsItemsControl" ItemsSource="{Binding Cards}" Margin="4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ModelCardViewModel">
                                <views:ModelCardTile/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionRect" IsVisible="False"
                                   Stroke="#E67E22" StrokeThickness="1"
                                   Fill="#20E67E22"/>
                    </Canvas>
                </Grid>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Text="{Binding EmptyStateText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       IsVisible="{Binding IsEmpty}"/>
            </Grid>
        </Grid>

        <Border IsVisible="{Binding ShowScanWarning}" Background="#80000000">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8" Padding="24" MaxWidth="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #50000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding ScanWarningTitle}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ScanWarningMessage}" TextWrapping="Wrap" MaxWidth="470"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{Binding ScanWarningCancelText}" Command="{Binding CancelScanCommand}" IsCancel="True" Padding="14,8"/>
                        <Button Content="{Binding ScanWarningContinueText}" Command="{Binding ConfirmScanCommand}" IsDefault="True"
                                Background="#E67E22" Foreground="White" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border IsVisible="{Binding ShowSaveFilterDialog}" Background="#80000000">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8" Padding="24" MaxWidth="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #50000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding SaveFilterDialogTitle}" FontSize="18" FontWeight="Bold"/>
                    <TextBox Text="{Binding NewCollectionName, Mode=TwoWay}"
                             Watermark="{Binding SaveFilterDialogPlaceholder}"
                             MinWidth="320"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{Binding SaveFilterDialogCancelText}" Command="{Binding CancelSaveFilterCommand}" IsCancel="True" Padding="14,8"/>
                        <Button Content="{Binding SaveFilterDialogSaveText}" Command="{Binding ConfirmSaveFilterCommand}" IsDefault="True"
                                Background="#E67E22" Foreground="White" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Border IsVisible="{Binding ShowRenameTagDialog}" Background="#80000000">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8" Padding="24" MaxWidth="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #50000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding RenameTagDialogTitle}" FontSize="18" FontWeight="Bold"/>
                    <TextBox Text="{Binding NewTagName, Mode=TwoWay}"
                             Watermark="{Binding RenameTagDialogPlaceholder}"
                             MinWidth="320"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{Binding RenameTagDialogCancelText}" Command="{Binding CancelRenameTagCommand}" IsCancel="True" Padding="14,8"/>
                        <Button Content="{Binding RenameTagDialogSaveText}" Command="{Binding ConfirmRenameTagCommand}" IsDefault="True"
                                Background="#E67E22" Foreground="White" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border IsVisible="{Binding ShowDeleteTagConfirm}" Background="#80000000">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8" Padding="24" MaxWidth="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #50000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding DeleteTagDialogTitle}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DeleteTagMessage}" TextWrapping="Wrap" MaxWidth="440"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{Binding DeleteTagDialogCancelText}" Command="{Binding CancelDeleteTagCommand}" IsCancel="True" Padding="14,8"/>
                        <Button Content="{Binding DeleteTagDialogDeleteText}" Command="{Binding ConfirmDeleteTagCommand}" IsDefault="True"
                                Background="#E74C3C" Foreground="White" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border IsVisible="{Binding ShowColorPickerDialog}" Background="#80000000">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8" Padding="24" MaxWidth="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #50000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding ColorPickerTitle}" FontSize="18" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox Text="{Binding NewTagColor, Mode=TwoWay}"
                                 Watermark="{Binding ColorPickerPlaceholder}"
                                 MinWidth="240" VerticalAlignment="Center"/>
                        <Border Width="32" Height="32" CornerRadius="4"
                                Background="{Binding ColorPreviewBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                BorderThickness="1" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{Binding ColorPickerCancelText}" Command="{Binding CancelColorPickerCommand}" IsCancel="True" Padding="14,8"/>
                        <Button Content="{Binding ColorPickerSaveText}" Command="{Binding ConfirmColorPickerCommand}" IsDefault="True"
                                Background="#E67E22" Foreground="White" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 0.5.6b.2: Group tag dialog -->
        <Border IsVisible="{Binding ShowGroupTagDialog}" Background="#80000000">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8" Padding="24" MaxWidth="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #50000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding GroupTagDialogTitle}" FontSize="18" FontWeight="Bold"/>
                    <AutoCompleteBox ItemsSource="{Binding GroupTagCandidates}"
                                     Text="{Binding GroupTagName, Mode=TwoWay}"
                                     Watermark="{Binding GroupTagDialogPlaceholder}"
                                     MinWidth="320"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{Binding GroupTagDialogCancelText}" Command="{Binding CancelGroupTagCommand}" Padding="14,8"/>
                        <Button Content="{Binding GroupTagDialogAddText}" Command="{Binding ConfirmGroupTagCommand}"
                                Background="#E67E22" Foreground="White" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 0.5.6b.2: Group remove confirm -->
        <Border IsVisible="{Binding ShowGroupRemoveConfirm}" Background="#80000000">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8" Padding="24" MaxWidth="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #50000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding GroupRemoveDialogTitle}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding GroupRemoveMessage}" TextWrapping="Wrap" MaxWidth="440"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{Binding GroupRemoveDialogCancelText}" Command="{Binding CancelGroupRemoveCommand}" Padding="14,8"/>
                        <Button Content="{Binding GroupRemoveDialogRemoveText}" Command="{Binding ConfirmGroupRemoveCommand}"
                                Background="#E74C3C" Foreground="White" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
